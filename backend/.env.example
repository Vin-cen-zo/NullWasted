APP_NAME=NullWasted API
ENVIRONMENT=development
ENABLE_TIME_SIMULATION=true

# Local SQLite (default) OR Neon Serverless PostgreSQL 16 Pooled URL:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./nullwasted_local.db

# Security Secrets (MUST override with strong random values in cloud deployment)
JWT_SECRET=change_me_to_a_strong_64_char_random_secret
PIN_SALT=change_me_to_a_strong_32_char_random_salt

# CORS Origin Regex (defaults to localhost, LAN, *.pages.dev, *.vercel.app)
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|.*\.pages\.dev|.*\.vercel\.app)(:\d+)?$

# Google AI Studio Gemini Key Pool
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Cloudinary Storage (Optional: falls back to local static uploads if unset)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Midtrans Core API Sandbox / Production (Optional: leave empty to use Cash on Pickup only)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
